{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/universidade-real", "destination": "/universidade-vc", "permanent": true }
  ],
  "rewrites": [
    { "source": "/meus-acessos", "destination": "/entrar" },
    { "source": "/admin", "destination": "/entrar" },
    { "source": "/admin/universidade", "destination": "/administracao-universidade" },
    { "source": "/empresa/universidade", "destination": "/gestao-empresa-universidade" },
    { "source": "/universidade/empresas", "destination": "/formacao-empresas" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://ctzgsxxbyvruzmfqibnl.supabase.co; font-src 'self' https://fonts.gstatic.com; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https://ctzgsxxbyvruzmfqibnl.supabase.co; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; upgrade-insecure-requests" }
      ]
    }
  ]
}
